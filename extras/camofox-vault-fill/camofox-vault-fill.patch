+def _camofox_evaluate(task_id: str, expression: str) -> Dict[str, Any]:
+    """Evaluate on the Camofox tab the browser_* tools drive (Camofox mode has no CDP supervisor).
+
+    The expression travels as a JSON body over Camofox's loopback REST API into Playwright's
+    page.evaluate: never subprocess argv, and Camofox logs only the result type, so the
+    secret-bearing fill may use it. Same raw task_id keying as browser_console's Camofox path.
+    """
+    from tools.browser_camofox import _ensure_tab, _post
+
+    try:
+        tab = _ensure_tab(task_id or "default")
+        tab_id = tab.get("tab_id") or tab.get("id")
+        resp = _post(f"/tabs/{tab_id}/evaluate", body={"expression": expression, "userId": tab["user_id"]})
+    except Exception as exc:
+        return {"success": False, "error_type": "eval_failed", "error": f"Camofox evaluate failed: {exc}"}
+    if isinstance(resp, dict) and resp.get("ok"):
+        return {"success": True, "result": resp.get("result")}
+    return {"success": False, "error_type": "eval_failed",
+            "error": str((resp or {}).get("error") if isinstance(resp, dict) else resp) or "eval failed"}
+
